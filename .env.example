# All services stay on the same host. No .111 connection or GPU is required.
DATA_DIR=data
DATABASE_URL=postgresql+asyncpg://localhost:5432/landscapes
REDIS_URL=redis://localhost:6379/0
# For Docker analysis, set POSTGRES_PASSWORD and a matching DATABASE_URL
# only in the host-local .env; the database hostname inside Compose is db.
LANDSCAPES_PORT=9750
# Enable only with the compose "analysis" profile (database, migrations, worker).
ENABLE_ANALYSIS=false
PARALLEL_TILES=1
DERIVATIVE_WORKERS=2
DETECTION_WORKERS=2
DOWNLOAD_WORKERS=2
TERRAIN_WORKERS=2
SCAN_TILE_LIMIT=4
